  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Fern primary action with a restrained surface edge.",
      "html": "<button class=\"ds-button ds-button-primary\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>New interview</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;min-height:44px;padding:8px 16px;border:1px solid transparent;border-radius:var(--radius-md, .5rem);font-family:var(--font-geist-sans, Arial, sans-serif);font-size:14px;line-height:1.4;font-weight:500;white-space:normal;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;}.ds-button svg{width:16px;height:16px;flex-shrink:0;}.ds-button:focus-visible{outline:2px solid var(--ring, #1f6b45);outline-offset:3px;}.ds-button:disabled{pointer-events:none;border-color:var(--border, #e3e0da);background:var(--disabled, #eceae5);color:var(--disabled-foreground, #6b6862);}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-button-primary{background:var(--primary, #1f6b45);color:var(--primary-foreground, #fff);box-shadow:inset 0 1px 0 rgb(255 255 255 / .08),0 1px 2px rgb(20 19 18 / .08);}.ds-button-primary:hover{background:var(--primary-hover, #2a7f52);}.ds-button-primary:active{background:var(--primary-active, #175236);}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Bordered white secondary action, including opening the transcript.",
      "html": "<button class=\"ds-button ds-button-outline\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h6\"/></svg>Transcript</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;min-height:44px;padding:8px 16px;border:1px solid transparent;border-radius:var(--radius-md, .5rem);font-family:var(--font-geist-sans, Arial, sans-serif);font-size:14px;line-height:1.4;font-weight:500;white-space:normal;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;}.ds-button svg{width:16px;height:16px;flex-shrink:0;}.ds-button:focus-visible{outline:2px solid var(--ring, #1f6b45);outline-offset:3px;}.ds-button:disabled{pointer-events:none;border-color:var(--border, #e3e0da);background:var(--disabled, #eceae5);color:var(--disabled-foreground, #6b6862);}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-button-outline{background:var(--card, #fff);color:var(--foreground, #1c1b19);border-color:var(--border, #e3e0da);}.ds-button-outline:hover{background:var(--secondary-hover, #e3e0da);}.ds-button-outline:active{background:var(--secondary-active, #d8d5ce);}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral filled action.",
      "html": "<button class=\"ds-button ds-button-secondary\" type=\"button\">Cancel</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;min-height:44px;padding:8px 16px;border:1px solid transparent;border-radius:var(--radius-md, .5rem);font-family:var(--font-geist-sans, Arial, sans-serif);font-size:14px;line-height:1.4;font-weight:500;white-space:normal;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;}.ds-button svg{width:16px;height:16px;flex-shrink:0;}.ds-button:focus-visible{outline:2px solid var(--ring, #1f6b45);outline-offset:3px;}.ds-button:disabled{pointer-events:none;border-color:var(--border, #e3e0da);background:var(--disabled, #eceae5);color:var(--disabled-foreground, #6b6862);}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-button-secondary{background:var(--secondary, #eceae5);color:var(--secondary-foreground, #1c1b19);}.ds-button-secondary:hover{background:var(--secondary-hover, #e3e0da);}.ds-button-secondary:active{background:var(--secondary-active, #d8d5ce);}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet action that gains a neutral hover surface.",
      "html": "<button class=\"ds-button ds-button-ghost\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3ZM5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8\"/></svg>Mute</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;min-height:44px;padding:8px 16px;border:1px solid transparent;border-radius:var(--radius-md, .5rem);font-family:var(--font-geist-sans, Arial, sans-serif);font-size:14px;line-height:1.4;font-weight:500;white-space:normal;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;}.ds-button svg{width:16px;height:16px;flex-shrink:0;}.ds-button:focus-visible{outline:2px solid var(--ring, #1f6b45);outline-offset:3px;}.ds-button:disabled{pointer-events:none;border-color:var(--border, #e3e0da);background:var(--disabled, #eceae5);color:var(--disabled-foreground, #6b6862);}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-button-ghost{background:transparent;color:var(--muted-foreground, #6b6862);}.ds-button-ghost:hover{background:var(--secondary-hover, #e3e0da);color:var(--foreground, #1c1b19);}.ds-button-ghost:active{background:var(--secondary-active, #d8d5ce);}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Solid destructive action for confirmed deletion.",
      "html": "<button class=\"ds-button ds-button-destructive\" type=\"button\">Delete interview</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;min-height:44px;padding:8px 16px;border:1px solid transparent;border-radius:var(--radius-md, .5rem);font-family:var(--font-geist-sans, Arial, sans-serif);font-size:14px;line-height:1.4;font-weight:500;white-space:normal;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;}.ds-button svg{width:16px;height:16px;flex-shrink:0;}.ds-button:focus-visible{outline:2px solid var(--ring, #1f6b45);outline-offset:3px;}.ds-button:disabled{pointer-events:none;border-color:var(--border, #e3e0da);background:var(--disabled, #eceae5);color:var(--disabled-foreground, #6b6862);}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-button-destructive{background:var(--destructive, #a8261f);color:var(--destructive-foreground, #fff);}.ds-button-destructive:hover{background:var(--destructive-hover, #91231d);}.ds-button-destructive:active{background:var(--destructive-active, #7b1b16);}"
    },
    {
      "name": "Link Button",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Text action with fern ink and a hover underline.",
      "html": "<button class=\"ds-button ds-button-link\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>View history</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;min-height:44px;padding:8px 16px;border:1px solid transparent;border-radius:var(--radius-md, .5rem);font-family:var(--font-geist-sans, Arial, sans-serif);font-size:14px;line-height:1.4;font-weight:500;white-space:normal;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;}.ds-button svg{width:16px;height:16px;flex-shrink:0;}.ds-button:focus-visible{outline:2px solid var(--ring, #1f6b45);outline-offset:3px;}.ds-button:disabled{pointer-events:none;border-color:var(--border, #e3e0da);background:var(--disabled, #eceae5);color:var(--disabled-foreground, #6b6862);}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}.ds-button-link{background:transparent;color:var(--link, #1f6b45);border-radius:var(--radius-sm, .375rem);text-underline-offset:4px;}.ds-button-link:hover{color:var(--link-hover, #2a7f52);text-decoration:underline;}.ds-button-link:active{color:var(--primary-active, #175236);}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled white field with a stronger input stroke and visible fern focus.",
      "html": "<label class=\"ds-field\">Email<input class=\"ds-input\" type=\"email\" autocomplete=\"email\" placeholder=\"you@example.com\" /></label>",
      "css": ".ds-field{display:grid;gap:8px;font-family:var(--font-geist-sans, Arial, sans-serif);font-size:14px;font-weight:500;color:var(--foreground, #1c1b19);}.ds-input{width:100%;min-width:0;height:44px;border:1px solid var(--input, #918d86);border-radius:var(--radius-md,.5rem);background:var(--card, #fff);color:var(--foreground, #1c1b19);padding:8px 12px;font-family:var(--font-geist-sans, Arial, sans-serif);font-size:16px;caret-color:var(--primary, #1f6b45);transition:border-color 150ms;}.ds-input::placeholder{color:var(--muted-foreground, #6b6862);}.ds-input:hover{border-color:var(--input, #918d86);}.ds-input:focus-visible{outline:2px solid var(--ring, #1f6b45);outline-offset:3px;}.ds-input[aria-invalid=true]{border-color:var(--destructive, #a8261f);}.ds-input:disabled{background:var(--disabled, #eceae5);color:var(--disabled-foreground, #6b6862);}@media(min-width:768px){.ds-input{font-size:14px;}}@media(prefers-reduced-motion:reduce){.ds-input{transition:none;}}"
    },
    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "refersTo": "navigation-item-current",
      "description": "Aligned 44px navigation rows; the current route uses a white surface and fern icon, with no decorative dot.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-nav-item\" href=\"/dashboard\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z\"/></svg><span>Overview</span></a><a class=\"ds-nav-item\" href=\"/interviews/new\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg><span>New interview</span></a><a class=\"ds-nav-item\" href=\"/history\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 8v4l3 2M3 12a9 9 0 1 0 9-9 9 9 0 0 0-9 9\"/></svg><span>History</span></a></nav>",
      "css": ".ds-nav{display:grid;gap:4px;width:240px;max-width:100%;padding:12px;background:var(--sidebar, #f4f4f3);font-family:var(--font-geist-sans, Arial, sans-serif);}.ds-nav-item{display:flex;min-height:44px;align-items:center;gap:12px;border:1px solid transparent;border-radius:var(--radius-md,.5rem);padding:0 12px;color:var(--muted-foreground, #6b6862);font-size:13px;font-weight:500;text-decoration:none;transition:background-color 150ms;}.ds-nav-item svg{width:17px;height:17px;flex-shrink:0;}.ds-nav-item:hover,.ds-nav-item:active{background:var(--secondary, #eceae5);}.ds-nav-item[aria-current=page]{border-color:var(--border, #e3e0da);background:var(--card, #fff);color:var(--foreground, #1c1b19);box-shadow:0 1px 2px rgb(20 19 18 / .03);}.ds-nav-item[aria-current=page] svg{color:var(--primary, #1f6b45);}.ds-nav-item:focus-visible{outline:2px solid var(--ring, #1f6b45);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none;}}"
    },
    {
      "name": "Success Badge",
      "kind": "chip",
      "refersTo": "badge-success",
      "description": "A status pill that pairs success color with an explicit completed label.",
      "html": "<span class=\"ds-badge-success\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg>Completed</span>",
      "css": ".ds-badge-success{display:inline-flex;min-height:24px;align-items:center;justify-content:center;gap:4px;padding:2px 8px;border:1px solid var(--success-border, #a8dcc0);border-radius:9999px;background:var(--success-surface, #e2f3e9);color:var(--success, #175236);font-family:var(--font-geist-sans, Arial, sans-serif);font-size:11px;font-weight:500;white-space:normal;}.ds-badge-success svg{width:12px;height:12px;}"
    },
    {
      "name": "Working Panel",
      "kind": "card",
      "refersTo": "working-panel",
      "description": "A flat bordered white surface, shown as an empty practice metric.",
      "html": "<article class=\"ds-panel\"><h2 class=\"ds-panel-title\">Completed interviews</h2><p class=\"ds-panel-value\">0</p><p class=\"ds-panel-caption\">Sessions in your practice history</p></article>",
      "css": ".ds-panel{min-width:0;border:1px solid var(--border, #e3e0da);border-radius:var(--radius-xl,1rem);padding:20px;background:var(--card, #fff);color:var(--foreground, #1c1b19);font-family:var(--font-geist-sans, Arial, sans-serif);}.ds-panel-title{margin:0;color:var(--muted-foreground, #6b6862);font-size:12px;font-weight:400;line-height:16px;letter-spacing:normal;}.ds-panel-value{margin:16px 0 0;font-size:34px;line-height:1;font-weight:500;letter-spacing:-.04em;font-variant-numeric:tabular-nums;}.ds-panel-caption{margin:12px 0 0;color:var(--muted-foreground, #6b6862);font-size:11px;line-height:1.6;}"
    },
    {
      "name": "Voice Presence",
      "kind": "custom",
      "refersTo": "voice-visual",
      "description": "The listening-mode circular presence, separated from its accessible state label; size responds to both viewport width and height.",
      "html": "<div class=\"ds-voice\"><div class=\"ds-voice-visual\" aria-hidden=\"true\"><div class=\"ds-voice-outline\"></div><div class=\"ds-voice-reactive\"><div class=\"ds-voice-orb\"><div class=\"ds-voice-surface\"></div><div class=\"ds-voice-ribbons\"></div></div></div></div><p class=\"ds-voice-label\" role=\"status\">Listening to you</p><p class=\"ds-voice-hint\">Take your time. Think out loud.</p></div>",
      "css": ".ds-voice{display:flex;flex-direction:column;align-items:center;max-width:448px;width:100%;text-align:center;font-family:var(--font-geist-sans, Arial, sans-serif);color:var(--foreground, #1c1b19);}.ds-voice-visual{--voice-level:0;position:relative;width:clamp(144px,min(50vw,calc(100dvh - 550px)),264px);aspect-ratio:1;isolation:isolate;}.ds-voice-outline{position:absolute;inset:0;border:1px solid color-mix(in srgb,var(--primary, #1f6b45) 14%,transparent);border-radius:50%;}.ds-voice-reactive{position:absolute;inset:8%;transform:scale(calc(.97 + var(--voice-level)*.08));transition:transform 160ms ease-out;}.ds-voice-orb{position:absolute;inset:0;overflow:hidden;border-radius:50%;background:radial-gradient(circle at 32% 22%,var(--accent-active, #a8dcc0),var(--primary, #1f6b45) 55%,var(--primary-active, #175236) 90%);box-shadow:inset -8px -14px 28px color-mix(in srgb,var(--primary-active, #175236) 40%,transparent),0 14px 30px -20px var(--primary-active, #175236);animation:ds-breathe 5s ease-in-out infinite;}.ds-voice-surface{position:absolute;inset:-50%;border-radius:42%;background:radial-gradient(ellipse at 32% 30%,var(--accent-active, #a8dcc0),transparent 45%),radial-gradient(ellipse at 70% 72%,var(--primary-active, #175236),transparent 52%);mix-blend-mode:soft-light;opacity:.75;animation:ds-drift 16s linear infinite;}.ds-voice-ribbons{position:absolute;inset:32% -30% -52%;border:1px solid color-mix(in srgb,var(--primary-foreground, #fff) 45%,transparent);border-radius:42%;box-shadow:0 -9px 0 -8px color-mix(in srgb,var(--primary-foreground, #fff) 35%,transparent),0 -18px 0 -17px color-mix(in srgb,var(--primary-foreground, #fff) 25%,transparent);animation:ds-float 7s ease-in-out infinite;}.ds-voice-label{margin:16px 0 0;font-size:16px;font-weight:500;}.ds-voice-hint{margin:4px 0 0;max-width:40ch;font-size:12px;color:var(--muted-foreground, #6b6862);}@keyframes ds-breathe{0%,100%{transform:scale(.98);}50%{transform:scale(1.02);}}@keyframes ds-drift{to{transform:rotate(360deg);}}@keyframes ds-float{0%,100%{transform:translateY(-4%) rotate(-12deg);}50%{transform:translateY(5%) rotate(8deg);}}@media(prefers-reduced-motion:reduce){.ds-voice-orb,.ds-voice-surface,.ds-voice-ribbons{animation:none;}.ds-voice-reactive{transform:none;transition:none;}}"
    }
  ],
  "narrative": {
    "northStar": "A calm professional practice workspace",
    "overview": "Screenly gives spoken technical interview practice a steady working environment. Warm paper holds the page, a cooler sidebar anchors navigation, and white surfaces carry settings, saved sessions, and evidence. Charcoal type and fern actions make the interface feel calm, clear, and professional across landing, authentication, setup, conversation, and feedback.\n\nThe voice session is the signature expression: a centered, responsive fern presence, a concise state label, current attributed captions, and a compact control dock. The saved conversation expands inline within the page when requested. Product data and recovery states remain visible and truthful; the landing conversation is explicitly labeled as an example.",
    "keyCharacteristics": [
      "Warm paper, cooler navigation, white working surfaces, and charcoal hierarchy.",
      "Fern actions and selected controls; restrained candidate and status colors.",
      "Locally bundled Geist with compact labels and readable conversation text.",
      "A fixed desktop workspace shell that becomes a focus-managed mobile drawer.",
      "A voice stage that leads the live session, with recoverable real states and optional transcript reading."
    ],
    "rules": [
      {
        "name": "The Semantic First Rule",
        "body": "Apply the existing semantic role for an action, state, or surface; use the shared tokens rather than introducing a parallel palette per screen.",
        "section": "colors"
      },
      {
        "name": "The Local Type Rule",
        "body": "Extend the locally bundled Geist hierarchy across screens; retain the readable transcript role and visible label hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Use borders and tonal separation for ordinary panels; reserve the dock and sheet shadows for their implemented roles.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use semantic tokens and the shared interaction states across every screen.",
      "**Do** retain the fixed desktop sidebar and focus-managed mobile drawer at the implemented navigation breakpoint.",
      "**Do** keep live voice centered, current captions concise, and the full transcript available on request.",
      "**Do** preserve visible focus, labeled controls, mobile touch targets, and reduced-motion behavior.",
      "**Do** show real loading, empty, saved, failed, and recovery states alongside real product data.",
      "**Do** use the local Geist fonts and the extracted readable transcript hierarchy."
    ],
    "donts": [
      "**Don't** reintroduce the retired Jade presentation or a dark theme into this light-only visual world.",
      "**Don't** add a persistent large question panel or permanently expanded transcript to the live voice stage.",
      "**Don't** introduce fabricated production metrics, sessions, or feedback; keep the landing example explicitly labeled.",
      "**Don't** use candidate clay or status colors as competing primary action palettes.",
      "**Don't** make decorative motion necessary to understand session state or announce every partial spoken word."
    ]
  }
}
