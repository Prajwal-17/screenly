{
  "name": "ai-interviewer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:migrate:local": "bun run --cwd apps/backend db:migrate:local",
    "db:migrate:remote": "bun run --cwd apps/backend db:migrate:remote",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "format:check": "prettier --check .",
    "check": "bun run check-types && bun run lint && bun run test && bun run build",
    "deploy:backend": "bun run --cwd apps/backend deploy"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=22"
  }
}
