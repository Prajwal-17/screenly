    "@tanstack/react-query": "^5.90.21",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "next": "16.2.0",
    "onnxruntime-web": "1.30.0",
    "postcss": "^8.5.15",
    "radix-ui": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
