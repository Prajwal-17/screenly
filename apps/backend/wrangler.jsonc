{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenly-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "routes": [
    {
      "pattern": "screenly-api.prajwal.sh",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "screenly",
      "database_id": "3e2cb34a-99a8-4b00-8189-4939495e3841",
      "migrations_dir": "drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INTERVIEWS",
        "class_name": "InterviewRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InterviewRoom"],
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "ENABLE_DEV_LOGIN": "false",
    "FRONTEND_URL": "https://screenly.prajwal.sh",
    "BETTER_AUTH_URL": "https://screenly-api.prajwal.sh",
  },
}
