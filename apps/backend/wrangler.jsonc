{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-08",
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SocketServer"],
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SOCKET_OBJECT",
        "class_name": "SocketServer",
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "my-bucket",
    },
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
}
