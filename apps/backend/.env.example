PORT=8787
# Optional local D1 state directory (relative to apps/backend).
# D1_PERSIST_PATH=.wrangler/state
# Required for remote migrations and deployment. Create the D1 database first.
# CLOUDFLARE_API_TOKEN needs D1 edit and Worker deployment permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
FRONTEND_URL=http://localhost:3000

BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=

# Required for sign-in: Google OAuth (Web application)
# Redirect URI: http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
# Backstop for uncertain turn endings. Natural end-of-turn detection is unchanged.
DEEPGRAM_EOT_TIMEOUT_MS=3000
DEEPGRAM_TTS_MODEL=flux-elise-en
DEEPGRAM_TTS_SPEED=1.10

# Any compatible Chat Completions provider; choose your own model
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=
# Optional live-reply overrides; feedback keeps using LLM_MODEL.
# LLM_INTERVIEW_MODEL=your-fast-chat-model
# LLM_INTERVIEW_REASONING_EFFORT=low
# LLM_INTERVIEW_MAX_TOKENS=256

DEEPGRAM_TTS_EXPRESSIVITY=0

# Local development only. Also requires `bun run dev` and localhost URLs.
# Never set this on a deployed environment. `start` always disables it.
ENABLE_DEV_LOGIN=false
