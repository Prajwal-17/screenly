    "fflate": "^0.8.3",
    "hono": "^4.12.23",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "openai": "^7.9.0",
    "unpdf": "^1.9.1",
    "zod": "^4.3.6",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
